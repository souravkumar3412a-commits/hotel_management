# Copy this file to .env and fill in real values. Never commit .env to git.

# From Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Connection pooling" URI if offered, port 6543)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Where your frontend is served from. Comma-separate multiple origins.
# Local dev example: http://127.0.0.1:5500
# After deploying: https://your-site.vercel.app
FRONTEND_ORIGIN=http://127.0.0.1:5500

PORT=4000
